# Application environment: development | test | production
# Under APP_ENV=production, any dev-* default below causes the server to refuse to boot.
APP_ENV=development

# --- Postgres 18 ---
POSTGRES_DB=lomi
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev-postgres
POSTGRES_MIGRATOR_PASSWORD=dev-migrator
POSTGRES_APP_PASSWORD=dev-app
DATABASE_URL=postgresql://app:dev-app@127.0.0.1:5432/lomi
DATABASE_MIGRATOR_URL=postgresql://migrator:dev-migrator@127.0.0.1:5432/lomi

# --- Redis 8 (disposable BullMQ coordination) ---
REDIS_PASSWORD=dev-redis
REDIS_URL=redis://:dev-redis@127.0.0.1:6379

# --- S3 / SeaweedFS (dev-only credentials matching infra/seaweedfs/s3.json) ---
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET=documents
S3_ACCESS_KEY=dev-s3-key
S3_SECRET_KEY=dev-s3-secret

# --- API (:3000) — NEVER receives LLM API keys ---
API_PORT=3000
TRUST_PROXY_CIDR=172.30.0.0/24
DEBUG_ENDPOINTS=false

# --- Worker (:3001 health/metrics) — receives LLM keys only here ---
WORKER_HEALTH_PORT=3001
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash
LLM_LIMIT_MAX=1
LLM_LIMIT_DURATION_MS=12000
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Web (Vite build-time) ---
VITE_API_BASE=/api
