{
  "name": "@app/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:int": "vitest run --passWithNoTests test/int",
    "test:chaos": "vitest run --passWithNoTests test/chaos",
    "dev": "echo 'API NestJS dev server is added in Core Task 9'"
  },
  "dependencies": {
    "@app/config": "workspace:*",
    "@app/contracts": "workspace:*",
    "@app/core": "workspace:*",
    "@app/db": "workspace:*",
    "@app/storage": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.19.4",
    "typescript": "^5.9.3",
    "vitest": "^5.1.2"
  }
}
