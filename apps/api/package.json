{
  "name": "@app/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "swc src -d dist/src --strip-leading-paths",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run test/unit --passWithNoTests",
    "test:int": "vitest run --passWithNoTests test/int test/contract",
    "test:chaos": "vitest run --passWithNoTests test/chaos",
    "dev": "swc src -d dist/src --strip-leading-paths && node --watch dist/src/main.js"
  },
  "dependencies": {
    "@app/config": "workspace:*",
    "@app/contracts": "workspace:*",
    "@app/core": "workspace:*",
    "@app/db": "workspace:*",
    "@app/storage": "workspace:*",
    "@nestjs/common": "^12.6.3",
    "@nestjs/core": "^12.6.3",
    "@nestjs/platform-express": "^12.6.3",
    "bullmq": "^6.7.10",
    "ioredis": "^6.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.19.4",
    "fast-check": "^4.11.0",
    "typescript": "^5.9.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.2"
  }
}
