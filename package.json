{
  "name": "document-review-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:int": "turbo run test:int",
    "test:chaos": "turbo run test:chaos",
    "test:e2e": "echo 'e2e tests are added in Core Task 12' && exit 1",
    "dev": "turbo run dev",
    "infra": "docker compose -f compose.yaml -f compose.dev.yaml up -d --wait",
    "infra:down": "docker compose -f compose.yaml -f compose.dev.yaml down",
    "stack": "docker compose up --build -d --wait",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @app/db db:generate",
    "db:migrate": "pnpm --filter @app/db db:migrate",
    "db:seed": "pnpm --filter @app/db db:seed",
    "db:check": "pnpm --filter @app/db db:check",
    "db:reset": "docker compose -f compose.yaml -f compose.dev.yaml down -v && pnpm infra && pnpm db:migrate && pnpm db:seed",
    "golden:update": "pnpm --filter @app/pdf build && node scripts/golden-update.ts",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.4",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.9",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.18.1",
    "lefthook": "^2.2.4",
    "pdf-lib": "1.17.1",
    "prettier": "^3.10.1",
    "turbo": "^2.11.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  }
}
