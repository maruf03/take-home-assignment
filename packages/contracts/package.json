{
  "name": "@app/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./status": {
      "types": "./dist/status.d.ts",
      "import": "./dist/status.js",
      "default": "./dist/status.js"
    },
    "./values": {
      "types": "./dist/values.d.ts",
      "import": "./dist/values.js",
      "default": "./dist/values.js"
    },
    "./page": {
      "types": "./dist/page.d.ts",
      "import": "./dist/page.js",
      "default": "./dist/page.js"
    },
    "./problems": {
      "types": "./dist/problems.d.ts",
      "import": "./dist/problems.js",
      "default": "./dist/problems.js"
    },
    "./ui-copy": {
      "types": "./dist/ui-copy.d.ts",
      "import": "./dist/ui-copy.js",
      "default": "./dist/ui-copy.js"
    },
    "./dto": {
      "types": "./dist/dto/index.d.ts",
      "import": "./dist/dto/index.js",
      "default": "./dist/dto/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:int": "vitest run --passWithNoTests test/int",
    "test:chaos": "vitest run --passWithNoTests test/chaos"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "fast-check": "^4.11.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.2"
  }
}
