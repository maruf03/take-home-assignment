{
  "name": "@app/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "drizzle",
    "assets"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests test/unit",
    "test:int": "vitest run test/schema test/repos",
    "test:chaos": "vitest run --passWithNoTests test/chaos",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "node dist/cli/migrate-and-seed.js --migrate-only",
    "db:seed": "node dist/cli/migrate-and-seed.js",
    "db:check": "drizzle-kit check --config drizzle.config.ts && drizzle-kit generate --config drizzle.config.ts && env -u GIT_DIR -u GIT_WORK_TREE git diff --exit-code -- drizzle && test -z \"$(env -u GIT_DIR -u GIT_WORK_TREE git ls-files --others --exclude-standard -- drizzle)\""
  },
  "dependencies": {
    "@app/config": "workspace:*",
    "@app/contracts": "workspace:*",
    "@aws-sdk/client-s3": "^3.1178.0",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.4",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3",
    "vitest": "^5.1.2"
  }
}
