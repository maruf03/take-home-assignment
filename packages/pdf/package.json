{
  "name": "@app/pdf",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "lint": "eslint .",
    "test": "tsc -p tsconfig.json && vitest run --passWithNoTests",
    "test:int": "vitest run --passWithNoTests test/int",
    "test:chaos": "vitest run --passWithNoTests test/chaos"
  },
  "dependencies": {
    "@app/contracts": "workspace:*",
    "pdfjs-dist": "6.5.438",
    "tinypool": "2.2.0",
    "unpdf": "2.2.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.4",
    "typescript": "^5.9.3",
    "vitest": "^5.1.2"
  }
}
