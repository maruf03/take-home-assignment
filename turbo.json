{
  "$schema": "https://turbo.build/schema.json",
  "envMode": "strict",
  "globalDependencies": ["tsconfig.base.json", ".nvmrc"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsconfig*.json", "package.json"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "test/**", "$TURBO_ROOT$/fixtures-golden/**"],
      "outputs": ["coverage/**"]
    },
    "test:int": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["DATABASE_URL*", "REDIS_URL*", "S3_*", "AWS_*", "NODE_EXTRA_CA_CERTS"]
    },
    "test:chaos": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["DATABASE_URL*", "REDIS_*", "S3_*", "AWS_*", "NODE_EXTRA_CA_CERTS"]
    },
    "db:check": {
      "cache": false
    },
    "mutation": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
